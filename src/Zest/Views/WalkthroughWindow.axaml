<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Zest.ViewModels"
        x:Class="Zest.Views.WalkthroughWindow"
        x:DataType="vm:WalkthroughViewModel"
        Icon="/Assets/zest.png"
        Width="1100" Height="900" MinWidth="560" MinHeight="420"
        Background="{DynamicResource BackgroundBrush}"
        Title="{Binding GameTitle, StringFormat='{}{0} · Walkthrough'}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Alt+Right" Command="{Binding NextCommand}" />
        <KeyBinding Gesture="Alt+Left" Command="{Binding PreviousCommand}" />
    </Window.KeyBindings>

    <Window.Resources>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="ChipTemplate" x:DataType="vm:CollectibleViewModel">
            <Border Classes="chip" Opacity="{Binding Opacity}">
                <TextBlock FontSize="13">
                    <Run Text="{Binding Mark}" FontWeight="Bold" />
                    <Run Text=" " />
                    <Run Text="{Binding Name}" />
                </TextBlock>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="{DynamicResource ContainerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="ListBox#ChapterList ListBoxItem">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource ContainerHighBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="16" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="14">
        <!-- Credit: StrategyWiki's licence asks for it on every page shown -->
        <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="11" Margin="4,8,4,0" TextWrapping="Wrap" Text="{Binding Credit}" />

        <TabControl x:Name="Tabs">
            <!-- Ocarina of Time (Switch 2): the game's own Adventure Log and a tracker, read from the newest save -->
            <TabItem x:Name="LogTab" Header="Adventure log" IsVisible="{Binding HasAdventureLog}">
                <Grid ColumnDefinitions="360,12,*" Margin="0,8,0,0" DataContext="{Binding AdventureLog}" x:DataType="vm:AdventureLogViewModel">
                    <!-- Where you are: the save's own picture, place and numbers; what to do next -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12">
                            <Border Classes="section" Padding="0" ClipToBounds="True" IsVisible="{Binding Picture, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Image Source="{Binding Picture}" Stretch="UniformToFill" MaxHeight="203" />
                            </Border>
                            <Border Classes="section">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="muted" FontSize="12" Text="{Binding Where}" TextWrapping="Wrap" />
                                    <TextBlock FontSize="14" Text="{Binding Stats}" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" FontSize="12" Text="{Binding Counts}" TextWrapping="Wrap" />
                                    <ComboBox ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}" HorizontalAlignment="Stretch" ToolTip.Tip="Which save to show">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SlotChoice">
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <CheckBox IsChecked="{Binding FollowLatest}" ToolTip.Tip="Switch to the newest save each time the game saves">
                                            <TextBlock Text="Follow the latest save" />
                                        </CheckBox>
                                        <Button Grid.Column="1" Classes="outlined" Command="{Binding RefreshCommand}" ToolTip.Tip="Read the saves again">
                                            <TextBlock Text="Refresh" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Classes="section" IsVisible="{Binding NextUp, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel Spacing="6" DataContext="{Binding NextUp}" x:DataType="vm:QuestViewModel">
                                    <TextBlock Classes="muted" FontSize="12" FontWeight="Bold" Text="NEXT UP" />
                                    <TextBlock Classes="title" FontSize="20" Text="{Binding NextAction}" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" FontSize="13" Text="{Binding Name}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="4,0" TextWrapping="Wrap" Text="{Binding Message}"
                                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- The log and the tracker -->
                    <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasProgress}">
                        <StackPanel Spacing="12" Margin="0,0,8,8">
                            <TextBlock Classes="title" FontSize="18" Text="In progress" Margin="4,0" />
                            <ItemsControl ItemsSource="{Binding Current}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:QuestViewModel">
                                        <Border Classes="section">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel>
                                                        <TextBlock Classes="muted" FontSize="11" FontWeight="Bold" Text="{Binding Kind}" />
                                                        <TextBlock Classes="title" FontSize="17" Text="{Binding Name}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="outlined" VerticalAlignment="Top" IsVisible="{Binding HasGuide}"
                                                            Command="{Binding $parent[ItemsControl].((vm:AdventureLogViewModel)DataContext).OpenGuideCommand}"
                                                            CommandParameter="{Binding}" ToolTip.Tip="Open this part of the walkthrough">
                                                        <TextBlock Text="Guide" />
                                                    </Button>
                                                </Grid>
                                                <TextBlock FontSize="14" Text="{Binding Summary}" TextWrapping="Wrap" IsVisible="{Binding HasSummary}" />
                                                <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding HasNextAction}"
                                                           Text="{Binding NextAction, StringFormat='Next: {0}'}" />
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding HasProgressBar}">
                                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction}" Height="6" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Classes="muted" FontSize="11" Text="{Binding StepText}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The tracker: stones, songs, badges, the party… one section per group -->
                            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GroupViewModel">
                                        <Border Classes="section">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="muted" FontSize="12" FontWeight="Bold" Text="{Binding Header}" />
                                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="title" FontSize="18" Text="Dungeons" Margin="4,8,4,0" IsVisible="{Binding HasDungeons}" />
                            <Border Classes="section" IsVisible="{Binding HasDungeons}">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,110,64,72,72,52">
                                        <TextBlock Classes="muted" FontSize="12" Text="Dungeon" />
                                        <TextBlock Grid.Column="1" Classes="muted" FontSize="12" Text="Status" />
                                        <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="Map" />
                                        <TextBlock Grid.Column="3" Classes="muted" FontSize="12" Text="Compass" />
                                        <TextBlock Grid.Column="4" Classes="muted" FontSize="12" Text="Boss key" />
                                        <TextBlock Grid.Column="5" Classes="muted" FontSize="12" Text="Keys" ToolTip.Tip="Small keys in hand" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Dungeons}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DungeonViewModel">
                                                <Grid ColumnDefinitions="*,110,64,72,72,52" Opacity="{Binding Opacity}" Margin="0,3">
                                                    <TextBlock FontSize="14" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" FontSize="14" Text="{Binding Status}" />
                                                    <TextBlock Grid.Column="2" FontSize="14" Text="{Binding Map}" />
                                                    <TextBlock Grid.Column="3" FontSize="14" Text="{Binding Compass}" />
                                                    <TextBlock Grid.Column="4" FontSize="14" Text="{Binding BossKey}" />
                                                    <TextBlock Grid.Column="5" FontSize="14" Text="{Binding Keys}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Expander Header="Completed quests" HorizontalAlignment="Stretch" Margin="0,8,0,0" IsVisible="{Binding HasCompleted}">
                                <ItemsControl ItemsSource="{Binding Completed}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:QuestViewModel">
                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="muted" FontSize="11" FontWeight="Bold" Text="{Binding Kind}" />
                                                <TextBlock Classes="title" FontSize="16" Text="{Binding Name, StringFormat='✓ {0}'}" TextWrapping="Wrap" />
                                                <TextBlock FontSize="14" Text="{Binding Summary}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <TextBlock Classes="muted" FontSize="11" Margin="4,4" TextWrapping="Wrap" Text="{Binding Footer}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="GuideTab" Header="Guide">
                <Grid ColumnDefinitions="280,12,*" Margin="0,8,0,0">
                    <!-- Chapters, grouped as in the guide's Table of Contents; tick the ones you've done -->
                    <Border Classes="section" Padding="6,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="8,0,8,8">
                                <TextBlock Classes="title" FontSize="16" Text="{Binding GuideName}" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" FontSize="12" Text="{Binding Summary}" TextWrapping="Wrap" />
                                <TextBlock FontSize="12" Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding !HasGuide}" />
                            </StackPanel>
                            <ListBox x:Name="ChapterList" ItemsSource="{Binding Chapters}" SelectedItem="{Binding SelectedChapter}" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChapterViewModel">
                                        <StackPanel>
                                            <TextBlock Classes="muted" FontSize="11" FontWeight="Bold" Margin="2,8,0,2" Text="{Binding Group}" IsVisible="{Binding ShowGroup}" />
                                            <CheckBox IsChecked="{Binding Done}" ToolTip.Tip="Done">
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                            </CheckBox>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- The page -->
                    <Border Grid.Column="2" Classes="section" Padding="0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="18,12,12,8">
                                <TextBlock Classes="title" FontSize="20" VerticalAlignment="Center" Text="{Binding PageTitle}" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="outlined" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous chapter (Alt+Left)">
                                        <TextBlock Text="‹ Previous" />
                                    </Button>
                                    <Button Classes="primary" Command="{Binding MarkDoneAndNextCommand}" ToolTip.Tip="Tick this chapter and go to the next">
                                        <TextBlock Text="Done ›" />
                                    </Button>
                                    <Button Classes="outlined" Command="{Binding NextCommand}" ToolTip.Tip="Next chapter (Alt+Right)">
                                        <TextBlock Text="Next ›" />
                                    </Button>
                                    <Button Classes="outlined" Command="{Binding AddPageToChecklistCommand}" ToolTip.Tip="Add this page to your checklist">
                                        <TextBlock Text="+ Checklist" />
                                    </Button>
                                    <Button Classes="outlined" Command="{Binding OpenOnWikiCommand}" ToolTip.Tip="Open this page on StrategyWiki">
                                        <TextBlock Text="Web" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="4" Margin="18,0" IsVisible="{Binding IsLoadingPage}" />
                            <TextBlock DockPanel.Dock="Top" Margin="18,6" TextWrapping="Wrap" Text="{Binding PageError}"
                                       IsVisible="{Binding PageError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PageContent" Margin="22,4,22,24" Spacing="10" MaxWidth="900" HorizontalAlignment="Left" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="NotesTab" Header="My notes">
                <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                    <!-- The manual checklist; the Adventure Log replaces it where the game's saves can be read -->
                    <Border Classes="section" Width="380" Margin="0,0,12,0" IsVisible="{Binding ShowChecklist}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="title" FontSize="16" Text="Checklist" Margin="0,0,0,8" />
                            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                                <TextBox x:Name="NewItemBox" Text="{Binding NewItem}" Watermark="Add an item (Enter)…" />
                                <Button Grid.Column="1" Classes="primary" Command="{Binding AddItemCommand}">
                                    <TextBlock Text="Add" />
                                </Button>
                            </Grid>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Checklist}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CheckItemViewModel">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                                                <CheckBox IsChecked="{Binding Done}">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                </CheckBox>
                                                <Button Grid.Column="1" Classes="outlined" Padding="8,2" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove">
                                                    <TextBlock Text="✕" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="section">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="title" FontSize="16" Text="Notes" Margin="0,0,0,8" />
                            <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="11" Margin="0,6,0,0" Text="Saved as you type, per game." />
                            <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" FontSize="15"
                                     Watermark="Where you left off, codes, things to come back for…" VerticalContentAlignment="Top" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
