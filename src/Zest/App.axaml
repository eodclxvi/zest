<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Zest.App"
             RequestedThemeVariant="Dark">

    <!-- Colors (Background, Primary, ...Brush, CardGlowBrush) are set by ThemeService at startup and when the
         theme changes, so views must use DynamicResource for them. -->
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="TitleFont">avares://Zest/Assets/Fonts#Bricolage Grotesque</FontFamily>
            <FontFamily x:Key="BodyFont">avares://Zest/Assets/Fonts#DM Sans</FontFamily>

            <!-- Material icons used by Lemon (Apache 2.0). -->
