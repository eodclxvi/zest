            <StreamGeometry x:Key="IconCarousel">M7,19h10V4H7v15zM2,17h4V6H2v11zM18,6v11h4V6h-4z</StreamGeometry>
            <StreamGeometry x:Key="IconGrid">M4,4h7v7H4zM13,4h7v7h-7zM4,13h7v7H4zM13,13h7v7h-7z</StreamGeometry>
            <StreamGeometry x:Key="IconBack">M20,11H7.83l5.59,-5.59L12,4l-8,8 8,8 1.41,-1.41L7.83,13H20v-2z</StreamGeometry>
            <StreamGeometry x:Key="IconInfo">M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM13,17h-2v-6h2v6zM13,9h-2V7h2v2z</StreamGeometry>
            <StreamGeometry x:Key="IconEye">M12,4.5C7.05,4.5 2.73,7.61 1,12c1.73,4.39 6.05,7.5 11,7.5s9.27,-3.11 11,-7.5c-1.73,-4.39 -6.05,-7.5 -11,-7.5zM12,17c-2.76,0 -5,-2.24 -5,-5s2.24,-5 5,-5 5,2.24 5,5 -2.24,5 -5,5zM12,8c-2.21,0 -4,1.79 -4,4s1.79,4 4,4 4,-1.79 4,-4 -1.79,-4 -4,-4z</StreamGeometry>
            <StreamGeometry x:Key="IconHide">M12,7c2.76,0 5,2.24 5,5 0,0.65 -0.13,1.26 -0.36,1.83l2.92,2.92c1.51,-1.26 2.7,-2.89 3.43,-4.75 -1.73,-4.39 -6,-7.5 -11,-7.5 -1.4,0 -2.74,0.25 -3.98,0.7l2.16,2.16C10.74,7.13 11.35,7 12,7zM2,4.27l2.28,2.28 0.46,0.46C3.08,8.3 1.78,10.02 1,12c1.73,4.39 6,7.5 11,7.5 1.55,0 3.03,-0.3 4.38,-0.84l0.42,0.42L19.73,22 21,20.73 3.27,3 2,4.27zM7.53,9.8l1.55,1.55c-0.05,0.21 -0.08,0.43 -0.08,0.65 0,1.66 1.34,3 3,3 0.22,0 0.44,-0.03 0.65,-0.08l1.55,1.55c-0.67,0.33 -1.41,0.53 -2.2,0.53 -2.76,0 -5,-2.24 -5,-5 0,-0.79 0.2,-1.53 0.53,-2.2zM11.84,9.02l3.15,3.15 0.02,-0.16c0,-1.66 -1.34,-3 -3,-3l-0.17,0.01z</StreamGeometry>
            <!-- Anvil, for Forge. -->
            <StreamGeometry x:Key="IconForge">M2,6h13v2c2.5,0 5,-0.6 7,-2v4c-1.7,1.6 -3.9,2.6 -6.3,2.9 -0.6,1 -1.6,1.8 -2.7,2.2V17h2v3H5v-3h2v-1.9C4.7,14.3 3,12.1 3,9.5V8L2,7.5z</StreamGeometry>
            <StreamGeometry x:Key="IconGamepad">M21,6H3c-1.1,0 -2,0.9 -2,2v8c0,1.1 0.9,2 2,2h18c1.1,0 2,-0.9 2,-2V8c0,-1.1 -0.9,-2 -2,-2zM11,13H8v3H6v-3H3v-2h3V8h2v3h3v2zM15.5,15c-0.83,0 -1.5,-0.67 -1.5,-1.5s0.67,-1.5 1.5,-1.5 1.5,0.67 1.5,1.5 -0.67,1.5 -1.5,1.5zM19.5,12c-0.83,0 -1.5,-0.67 -1.5,-1.5S18.67,9 19.5,9 21,9.67 21,10.5 20.33,12 19.5,12z</StreamGeometry>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#FFD43B</Color>
                    <Color x:Key="SystemAccentColorDark1">#E6BE30</Color>
                    <Color x:Key="SystemAccentColorLight1">#FFE27A</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        </Style>

        <Style Selector="TextBlock.title">
            <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
        </Style>

        <!-- 42px outlined round header buttons (fragment_games.xml). -->
        <Style Selector="Button.round">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.round:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ContainerHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        </Style>
        <Style Selector="Button.round PathIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>

        <!-- Platform filter chips. -->
        <Style Selector="Button.chip">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ContainerHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        </Style>
        <Style Selector="Button.chip.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
        </Style>

        <!-- Filled primary button. -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
        </Style>
        <Style Selector="Button.primary PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
        </Style>
        <Style Selector="Button.outlined">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18,8" />
        </Style>
        <Style Selector="Button.outlined:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ContainerHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        </Style>

        <!-- Small rounded label, e.g. "3DS" or "INSTALLED". -->
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Background" Value="{DynamicResource ScrimBrush}" />
        </Style>
        <Style Selector="Border.badge > TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="Border.badge.filled">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="Border.badge.filled > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
        </Style>

        <!-- Controller button hint, e.g. (A) Play. -->
        <Style Selector="Border.hint">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource ContainerHighestBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.hint > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.hint.wide">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Padding" Value="7,0" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="ContextMenu">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ContainerHighBrush}" />
        </Style>
    </Application.Styles>
</Application>
